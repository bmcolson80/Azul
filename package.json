{
  "name": "azul-game",
  "version": "1.0.0",
  "description": "Azul multiplayer board game - Node.js WebSocket server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/game.test.js",
    "test:e2e": "node --test --test-timeout=20000 tests/e2e.test.js",
    "test:all": "node --test --test-timeout=20000 tests/game.test.js tests/e2e.test.js"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
